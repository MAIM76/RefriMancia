<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== CABECERA CON IMAGEN ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/iv_detalle_imagen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background" />

                <!-- Degradado inferior sobre la imagen -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradiente_sombra"
                    android:rotation="180" />

                <!-- Botón volver circular -->
                <ImageButton
                    android:id="@+id/btn_volver_detalle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="@drawable/bg_btn_volver"
                    android:padding="8dp"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/recipe_back"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="44dp" />

                <!-- Título sobre el degradado -->
                <TextView
                    android:id="@+id/tv_detalle_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:padding="16dp"
                    android:text="@string/recipe_no_title"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowRadius="4" />

            </FrameLayout>

            <!-- ===== TARJETA DE METADATOS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/beige"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:elevation="2dp">

                <!-- Autor -->
                <TextView
                    android:id="@+id/tv_detalle_autor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_unknown_user"
                    android:textSize="14sp"
                    android:textColor="@color/marron_oscuro"
                    android:layout_marginBottom="10dp" />

                <!-- Fila: Tiempo · Dificultad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recipe_time_label"
                            android:textSize="13sp"
                            android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_detalle_tiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/recipe_time_not_available"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="#DDDDDD"
                        android:layout_marginHorizontal="12dp" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recipe_difficulty"
                            android:textSize="13sp"
                            android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_detalle_dificultad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/recipe_difficulty_not_specified"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Fila: Salud -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recipe_health_prefix"
                            android:textSize="13sp"
                            android:textColor="@color/black" />

                    <View
                        android:id="@+id/tv_detalle_semaforo_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/semaforo_dot" />

                    <TextView
                        android:id="@+id/tv_detalle_semaforo_texto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/semaforo_unknown"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== CONTENIDO ===== -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/beige"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp"
                    android:layout_marginTop="8dp">

                <!-- Ingredientes -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_ingredients_title"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/marron_oscuro"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                <TextView
                        android:id="@+id/tv_detalle_ingredientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#424242"
                        android:lineSpacingExtra="4dp" />

                <!-- Descripción -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_description_title"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginTop="20dp" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/marron_oscuro"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                <TextView
                        android:id="@+id/tv_detalle_descripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#424242"
                        android:lineSpacingExtra="4dp" />

                <!-- Información Nutricional -->
                <TextView
                        android:id="@+id/tv_nutricion_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_nutrition_title"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginTop="20dp" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/marron_oscuro"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp" />

                <!-- Tab bar: Total / Por 100g -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tab_total"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="@string/recipe_tab_total"
                            android:textSize="16sp"
                            android:textColor="@color/azul_oscuro"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#D9CDB8"
                            app:cornerRadius="0dp"
                            app:elevation="0dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tab_per100g"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="@string/recipe_tab_per100g"
                            android:textSize="16sp"
                            android:textColor="#9E9E9E"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="0dp"
                            app:elevation="0dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

                <!-- Contenedor nutricional con mismo fondo que la pantalla (efecto pestaña activa) -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#D9CDB8"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                <!-- Bloque Total -->
                <LinearLayout
                        android:id="@+id/ll_nutricion_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                    <!-- Kcal (valor único, no barra) -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/recipe_kcal_label"
                                android:textSize="14sp"
                                android:textColor="@color/azul_oscuro" />

                        <TextView
                                android:id="@+id/tv_nutricion_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"
                                android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Barra: Proteínas -->
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#C8BCA8"
                            android:layout_marginVertical="8dp"
                            android:id="@+id/view" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recipe_protein_label"
                                    android:textSize="14sp"
                                    android:textColor="@color/azul_oscuro" />

                            <TextView
                                    android:id="@+id/tv_nutricion_proteinas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#1A1A1A" />
                        </LinearLayout>
                        <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:background="#E0E0E0"
                                android:layout_marginTop="4dp">
                            <View
                                    android:id="@+id/bar_proteinas"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#EF5350" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#C8BCA8"
                            android:layout_marginVertical="8dp" />

                    <!-- Barra: Grasas + Grasas saturadas superpuestas -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recipe_fat_label"
                                    android:textSize="14sp"
                                    android:textColor="@color/azul_oscuro" />

                            <TextView
                                    android:id="@+id/tv_nutricion_grasas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#1A1A1A" />
                        </LinearLayout>
                        <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:background="#E0E0E0"
                                android:layout_marginTop="4dp">
                            <View
                                    android:id="@+id/bar_grasas"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#FFCA28" />
                            <View
                                    android:id="@+id/bar_grasas_saturadas"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#FFE082" />
                        </FrameLayout>

                        <TextView
                                android:id="@+id/tv_nutricion_grasas_saturadas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#6A5F50"
                                android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#C8BCA8"
                            android:layout_marginVertical="8dp" />

                    <!-- Barra: Carbohidratos + Azúcares superpuestos -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recipe_carbs_label"
                                    android:textSize="14sp"
                                    android:textColor="@color/azul_oscuro" />

                            <TextView
                                    android:id="@+id/tv_nutricion_carbohidratos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#1A1A1A" />
                        </LinearLayout>
                        <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:background="#E0E0E0"
                                android:layout_marginTop="4dp">
                            <View
                                    android:id="@+id/bar_carbohidratos"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#42A5F5" />
                            <View
                                    android:id="@+id/bar_azucares"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#90CAF9" />
                        </FrameLayout>

                        <TextView
                                android:id="@+id/tv_nutricion_azucares"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#6A5F50"
                                android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#C8BCA8"
                            android:layout_marginVertical="8dp" />

                    <!-- Barra: Fibra -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recipe_fiber_label"
                                    android:textSize="14sp"
                                    android:textColor="@color/azul_oscuro" />

                            <TextView
                                    android:id="@+id/tv_nutricion_fibra"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#1A1A1A" />
                        </LinearLayout>
                        <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:background="#E0E0E0"
                                android:layout_marginTop="4dp">
                            <View
                                    android:id="@+id/bar_fibra"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#66BB6A" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#C8BCA8"
                            android:layout_marginVertical="8dp" />

                    <!-- Barra: Sal -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recipe_salt_label"
                                    android:textSize="14sp"
                                    android:textColor="@color/azul_oscuro" />

                            <TextView
                                    android:id="@+id/tv_nutricion_sal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#1A1A1A" />
                        </LinearLayout>
                        <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:background="#E0E0E0"
                                android:layout_marginTop="4dp">
                            <View
                                    android:id="@+id/bar_sal"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="#78909C" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

                </LinearLayout>

                <Button
                        android:id="@+id/btn_ver_comentarios"
                        style="@style/estiloBotones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/recipe_view_comments" />

                <LinearLayout
                        android:id="@+id/ll_botones_propietario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                    <Button
                            android:id="@+id/btn_modificar_receta"
                            style="@style/estiloBotones"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/recipe_edit" />

                    <Button
                            android:id="@+id/btn_eliminar_receta"
                            style="@style/estiloBotones"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/recipe_delete" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
