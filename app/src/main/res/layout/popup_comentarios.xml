<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout para popup de comentarios de receta.
  Muestra lista de comentarios existentes y formulario para añadir nuevos.
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige">

    <!-- Título de la sección de comentarios -->
    <TextView
        android:id="@+id/tv_comentarios_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/popup_comments_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="16dp"
        android:background="@color/azul_oscuro"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    
    <!-- Banner modo edición (visible solo al editar) -->
    <LinearLayout
        android:id="@+id/layout_modo_edicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="#FFF3CD"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_comentarios_titulo">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/comment_editing_mode"
            android:textSize="12sp"
            android:textColor="#856404" />

        <TextView
            android:id="@+id/btn_cancelar_edicion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comment_cancel_edit"
            android:textSize="12sp"
            android:textColor="#856404"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Área para escribir nuevos comentarios (parte superior) -->
    <LinearLayout
        android:id="@+id/layout_escribir_comentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/beige"
        android:elevation="2dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/layout_modo_edicion">

        <!-- Campo de texto para nuevo comentario -->
        <EditText
                android:id="@+id/et_nuevo_comentario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/popup_comments_hint"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:maxLines="3"
                android:inputType="textMultiLine|textCapSentences"
                android:scrollbars="vertical" />

        <!-- Botón para enviar comentario -->
        <ImageButton
                android:id="@+id/btn_enviar_comentario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_boton_redondo"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="@string/popup_comments_send_desc"
                app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Divisor -->
    <View
        android:id="@+id/comentarios_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@id/layout_escribir_comentario"/>

    <!-- RecyclerView para lista de comentarios -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_comentarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/comentarios_divider"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
