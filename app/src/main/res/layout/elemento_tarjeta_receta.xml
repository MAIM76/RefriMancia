<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout para tarjeta de receta individual en RecyclerView.
  Muestra información completa de la receta: imagen, título, descripción,
  metadatos, valoración y botones de interacción.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sección de imagen y superposición de usuario -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/iv_imagen_receta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/recipe_image"
                android:src="@drawable/ic_launcher_background" />

            <!-- Superposición con nombre del usuario -->
            <TextView
                    android:id="@+id/tv_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="#8021180D"
                    android:padding="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/recipe_unknown_user"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
        </FrameLayout>

        <!-- Sección de información principal de la receta -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="12dp"
                android:paddingRight="12dp">

            <!-- Título de la receta -->

            <TextView
                    android:id="@+id/recipe_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_no_title"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:maxLines="1"
                    android:ellipsize="end" />

            <!-- Dificultad y categoría -->

            <!-- Línea con semáforo y tiempo -->
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                <!-- Indicador de semáforo nutricional -->
                <View
                        android:id="@+id/recipe_semaforo_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/semaforo_dot"
                        android:layout_marginTop="5dp" />

                <!-- Tiempo de preparación -->
                <TextView
                        android:id="@+id/recipe_dificultad_categoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:text="@string/recipe_no_category" />

            </LinearLayout>

            <TextView
                    android:id="@+id/recipe_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:text="@string/recipe_time_not_available"
                    android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Sección inferior: valoración + botones -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="bottom|center_vertical"
                android:orientation="horizontal">

            <!-- Estrellas de valoración -->
            <RatingBar
                    android:id="@+id/rb_media_puntuacion"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:isIndicator="true"
                    android:rating="0"
                    app:tint="?attr/colorPrimary"
                    android:paddingBottom="4dp" />

            <TextView
                    android:id="@+id/tv_media_puntuacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:paddingBottom="4dp"
                    android:textStyle="bold" />

            <!-- Separador flexible -->
            <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            <!-- Botón de valoración/me gusta -->
            <ImageView
                    android:id="@+id/btn_megusta"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="4dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="@string/recipe_review"
                    app:tint="?attr/colorPrimary" />

            <!-- Botón de comentarios -->
            <ImageView
                    android:id="@+id/btn_comentarios"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="4dp"
                    android:src="@android:drawable/sym_action_chat"
                    android:contentDescription="@string/recipe_comment"
                    app:tint="?attr/colorPrimary" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
