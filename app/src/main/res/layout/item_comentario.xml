<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout para item individual de comentario en RecyclerView.
  Muestra información del usuario, fecha y contenido del comentario.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackground">

    <!-- Sección de información del usuario -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

        <!-- Foto de perfil del usuario -->
        <ImageView
                android:id="@+id/iv_usuario_comentario"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:contentDescription="Foto de perfil del usuario" />

        <!-- Información de usuario y fecha -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- Nombre de usuario -->
            <TextView
                    android:id="@+id/tv_usuario_comentario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\@usuario"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/azul_oscuro" />

            <!-- Fecha del comentario -->
            <TextView
                    android:id="@+id/tv_fecha_comentario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textSize="12sp"
                    android:textColor="@color/gris_marron"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp" />
        </LinearLayout>

        <!-- Botones de acción (solo visibles para el autor) -->
        <LinearLayout
                android:id="@+id/ll_acciones_comentario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:visibility="gone">

            <TextView
                    android:id="@+id/btn_editar_comentario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/comment_edit"
                    android:textSize="12sp"
                    android:textColor="@color/azul_oscuro"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                    android:id="@+id/btn_eliminar_comentario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/comment_delete"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>
    </LinearLayout>

    <!-- Contenido del comentario -->
    <TextView
            android:id="@+id/tv_contenido_comentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contenido del comentario..."
            android:textSize="14sp"
            android:textColor="@color/azul_oscuro"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp" />


</LinearLayout>
