<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout para tarjeta de receta individual en RecyclerView.
  Muestra información completa de la receta: imagen, título, descripción,
  metadatos, valoración y botones de interacción.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/beige"
        app:cardCornerRadius="0dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Sección de imagen y superposición de usuario -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

            <ImageView
                    android:id="@+id/imagen_receta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/recipe_image"
                    android:src="@drawable/ic_launcher_background" />

            <!-- Superposición con nombre del usuario -->
            <TextView
                    android:id="@+id/texto_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="#8021180D"
                    android:padding="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/recipe_unknown_user"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <!-- Fecha de publicación (esquina superior derecha) -->
            <TextView
                    android:id="@+id/texto_fecha_publicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#8021180D"
                    android:padding="4dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

        </FrameLayout>

        <!-- Sección de información principal de la receta -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="12dp"
                android:paddingRight="12dp">

            <!-- Título -->
            <TextView
                    android:id="@+id/texto_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_no_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:maxLines="1"
                    android:ellipsize="end" />

            <!-- Fila 2: semáforo + tipo de comida | tiempo -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <View
                        android:id="@+id/indicador_semaforo"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/semaforo_dot" />

                <TextView
                        android:id="@+id/texto_tipo_tiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/marron_oscuro" />

            </LinearLayout>

            <!-- Fila 3: consumo habitual (IA) -->
            <TextView
                    android:id="@+id/texto_consumo_habitual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/gris_marron"
                    android:textStyle="italic" />

        </LinearLayout>

        <!-- Sección inferior: valoración + botones -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="bottom|center_vertical"
                android:orientation="horizontal">

            <!-- Estrellas de valoración -->
            <RatingBar
                    android:id="@+id/barra_valoracion"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:isIndicator="true"
                    android:rating="0"
                    app:tint="@color/amarillo"
                    android:paddingBottom="4dp"
                    android:progressTint="@color/amarillo"
                    android:secondaryProgressTint="@color/amarillo" />

            <TextView
                    android:id="@+id/texto_valoracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/gris_marron"
                    android:paddingBottom="4dp"
                    android:textStyle="bold" />

            <!-- Separador flexible -->
            <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            <!-- Botón de valoración/me gusta -->
            <ImageView
                    android:id="@+id/boton_valorar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="4dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="@string/recipe_review"
                    app:tint="@color/amarillo" />

            <!-- Botón de comentarios -->
            <ImageView
                    android:id="@+id/boton_comentarios"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="4dp"
                    android:src="@android:drawable/sym_action_chat"
                    android:contentDescription="@string/recipe_comment"
                    app:tint="@color/gris_marron" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
