<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ===== CABECERA DE PERFIL ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_perfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_perfil_header"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Borde blanco detrás de la foto -->
        <View
            android:id="@+id/foto_border"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_foto_perfil_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/bg_placeholder_circular"
            app:layout_constraintTop_toTopOf="@id/foto_border"
            app:layout_constraintBottom_toBottomOf="@id/foto_border"
            app:layout_constraintStart_toStartOf="@id/foto_border"
            app:layout_constraintEnd_toEndOf="@id/foto_border" />

        <TextView
            android:id="@+id/nombre_usuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recipe_user_placeholder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/profile_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/ll_botones_perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/nombre_usuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_editar_perfil"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/btn_editar_perfil"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#80FFFFFF" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btn_cerrar_sesion"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/btn_cerrar_sesion"
                android:textSize="13sp"
                android:textColor="#CCffffff"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== SECCIÓN MIS RECETAS ===== -->
    <TextView
        android:id="@+id/tv_mis_recetas_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/user_recipes_label"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/header_perfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/linea_mis_recetas"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#6750A4"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_mis_recetas_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_recetas_usuario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/linea_mis_recetas"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recetas_usuario"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/swipe_recetas_usuario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_no_recipes"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
