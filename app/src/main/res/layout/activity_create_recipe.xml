<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/fondoPantallas"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="120dp">

        <!-- Header Area (Rectangular, dark brown) -->
        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/marron_oscuro"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Container for the image (The gray border) -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- The actual image with rounded corners -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/recipeImagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Imagen de la receta"
                app:shapeAppearanceOverlay="@style/RoundedShape" />
        </FrameLayout>

        <!-- Time Section Container (Right side) -->

        <!-- 1. Nombre -->

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_input"
            android:backgroundTint="@color/gris_marron"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/etiquetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiempo de\npreparacion"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                tools:layout_editor_absoluteX="238dp"
                tools:layout_editor_absoluteY="100dp" />

            <TextView
                android:id="@+id/tvPrepTimeValue"
                style="@style/etiquetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="----"
                android:textColor="#CCCCCC"
                tools:layout_editor_absoluteX="281dp"
                tools:layout_editor_absoluteY="162dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelNombre"
            style="@style/etiquetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Nombre:"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageContainer" />

        <EditText
            android:id="@+id/etRecipeName"
            style="@style/editTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelNombre" />

        <!-- 2. Ingredientes -->
        <TextView
            android:id="@+id/labelIngredientes"
            style="@style/etiquetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:text="Ingredientes:"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etRecipeName" />

        <LinearLayout
            android:id="@+id/ingredientsList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelIngredientes">
        </LinearLayout>

        <EditText
            android:id="@+id/etNewIngredient"
            style="@style/editTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input"
            android:hint="Ingrediente"
            android:padding="12dp"
            app:layout_constraintEnd_toStartOf="@id/btnAddIngredient"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ingredientsList" />

        <Button
            style="@style/estiloBotones"
            android:id="@+id/btnAddIngredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Añadir"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="@id/etNewIngredient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/etNewIngredient" />

        <!-- 3. Categoria -->
        <TextView
            android:id="@+id/labelCategoria"
            style="@style/etiquetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:text="Categoria:"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNewIngredient" />

        <Spinner
            android:id="@+id/spinnerCategory"
            style="@style/editTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelCategoria" />

        <!-- 4. Descripcion -->
        <TextView
            android:id="@+id/labelDescripcion"
            style="@style/etiquetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:text="Descripcion:"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategory" />

        <EditText
            android:id="@+id/etRecipeDescription"
            style="@style/editTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:minLines="3"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelDescripcion" />

        <!-- Botones de Acción -->
        <Button
            style="@style/estiloBotones"
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="32dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etRecipeDescription" />

        <Button
            style="@style/estiloBotones"
            android:id="@+id/btnPublish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="32dp"
            android:text="Publicar"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etRecipeDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
