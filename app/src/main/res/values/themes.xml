<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RefriMancia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marron_oscuro</item>
        <item name="colorSecondary">@color/amarillo</item>
        <!-- Barra de notificaciones con color primario -->
        <item name="android:statusBarColor">@color/marron_oscuro</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.RefriMancia" parent="Base.Theme.RefriMancia" />

    <!-- Estilo para uCrop corregido -->
    <style name="Theme.UCrop" parent="Theme.AppCompat.Light">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- Estilo para que la foto interna sea redondeada -->
    <style name="RoundedShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <!-- Fondo para todas las ventanas -->
    <style name="fondoPantallas">
        <item name="android:background">@color/beige</item>
    </style>

    <!-- Color para botones A ARREGLAR-->
    <style name="estiloBotones">
        <item name="android:textColor">@color/amarillo</item>
        <item name="backgroundTint">@color/marron_oscuro</item>
    </style>
</resources>
