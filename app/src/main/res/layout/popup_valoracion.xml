<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout para popup de valoración de receta.
  Permite al usuario seleccionar una valoración de 1-5 estrellas y enviarla.
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Título del diálogo de valoración -->
    <TextView
        android:id="@+id/tv_valoracion_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/review_dialog_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divisor debajo del título -->
    <View
        android:id="@+id/valoracion_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@id/tv_valoracion_titulo" />

    <!-- Instrucción para el usuario -->
    <TextView
        android:id="@+id/tv_valoracion_receta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/review_dialog_hint"
        android:textSize="15sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/valoracion_divider" />

    <!-- Barra de valoración interactiva -->
    <RatingBar
        android:id="@+id/rb_valoracion"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:numStars="5"
        android:stepSize="1"
        android:rating="0"
        android:isIndicator="false"
        android:progressTint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_valoracion_receta" />

    <!-- Texto que muestra la valoración seleccionada -->
    <TextView
        android:id="@+id/tv_valoracion_seleccionada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/review_dialog_selection_empty"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#666666"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rb_valoracion" />

    <!-- Contenedor de botones de acción -->
    <LinearLayout
        android:id="@+id/layout_botones_valoracion"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:elevation="2dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Botón cancelar -->
        <Button
            android:id="@+id/btn_cancelar_valoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/review_dialog_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:textSize="16sp"
            android:textColor="?attr/colorPrimary" />

        <!-- Botón enviar valoración -->
        <Button
            android:id="@+id/btn_enviar_valoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/review_dialog_send"
            style="?android:attr/buttonBarButtonStyle"
            android:textSize="16sp"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
